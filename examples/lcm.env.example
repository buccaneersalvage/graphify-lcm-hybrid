# Copy to ~/.hermes/lcm.env (or source from your systemd unit).
# Do not commit the real file.

MEMORY_ROOT=/path/to/ai-memory
LCM_DATABASE_PATH=/path/to/ai-memory/lcm/lcm.db
LCM_LARGE_OUTPUT_EXTERNALIZATION_PATH=/path/to/ai-memory/lcm/payloads

# Leave doctor-clean-apply off unless you really mean to delete LCM rows.
# LCM_DOCTOR_CLEAN_APPLY_ENABLED=false
